# ==============================================================================
# Credit Assistant - Production Environment Variables (.env.example)
# ==============================================================================

# Database Configuration
# For production Supabase PostgreSQL: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# For local SQLite development: leave empty (defaults to sqlite:///./credit_assistant.db)
DATABASE_URL=

# JWT Authentication Secret Key
# Replace with a secure random 64-character secret in production
SECRET_KEY=

# Google Gemini API Key
# Required for AI Credit Risk Analysis & Financial Assistant chatbot
# If left empty, system automatically engages deterministic CIBIL rule-based fallback
GEMINI_API_KEY=

# Allowed CORS Origins (comma-separated URLs)
# Example: http://localhost:5173,http://localhost:3000,https://your-app.web.app
ALLOWED_ORIGINS=

