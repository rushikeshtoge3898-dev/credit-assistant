# ==============================================================================
# Credit Assistant - Backend Production Environment Variables
# ==============================================================================

# Security / JWT Configuration
SECRET_KEY=replace_with_a_secure_random_64_character_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite default: sqlite:///./credit_assistant.db
# Production PostgreSQL (e.g. Supabase / Neon / Cloud SQL): postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./credit_assistant.db

# Google Gemini API
# Required for AI Credit Risk Analysis & Financial Chatbot features
# If left empty, system automatically engages deterministic CIBIL rule-based engine fallback
GEMINI_API_KEY=

# CORS Configuration
# Comma-separated allowed frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Server Configuration
PORT=8000
HOST=0.0.0.0
